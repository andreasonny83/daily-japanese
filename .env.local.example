# Neon Postgres connection string.
# Get this from the Neon console: https://console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Neon Auth (Managed Better Auth).
# Auth URL from the Neon console -> Auth tab -> Configuration.
NEON_AUTH_BASE_URL=
# 32+ char secret for signing session cookies. Generate with `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
